{
  "name": "clickit",
  "version": "3.0.0",
  "private": true,
  "engines": { "node": ">=22.19.0" },
  "description": "Single-question quiz suggestions with hosted AI credits or your own API key",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:vision:live": "node scripts/live-vision.cjs",
    "test:server": "node --test tests/server.test.cjs",
    "dev:server": "wrangler dev --config server/wrangler.jsonc",
    "check:worker": "wrangler deploy --config server/wrangler.jsonc --dry-run --outdir dist/worker",
    "package:extension": "node scripts/package.cjs",
    "report:validation": "node scripts/validation-report.cjs"
  },
  "devDependencies": {
    "miniflare": "^5.20261104.0-beta",
    "playwright": "^1.64.1",
    "wrangler": "^4.158.0"
  }
}
